<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="PDF.master.cs" Inherits="PDFconvertor.PDF.PDF" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PDF Tools Webpage</title>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <link rel="stylesheet" href="../styles.css" />
</head>
<body>
    <form id="form1" runat="server">
        <!-- Navigation Bar (Static, outside ContentPlaceHolder) -->
        <nav class="navbar">
            <div class="navbar-container">
                <!-- Logo -->
                <div class="logo">
                    <span class="heart">❤️</span> <span class="logo-text">ImagePDFify</span>
                </div>

           

                <!-- Right Side (Login/Signup and Hamburger Menu) -->
               <div class="nav-right">
                    <a href="#" class="desktop-icon">🖥️</a>
                <a href="#" class="login" onclick="redirectToLogin()">Login/SignUp</a>

<%--                  <script>
              function redirectToLogin() {
              window.location.href = "Login.aspx";
               }
            </script>--%>

  

<style>
  /* General Link Styles */
  .login {
    font-size: 16px;
    font-weight: 500;
    color: #3498db; /* Light Blue */
    text-decoration: none;
    transition: color 0.3s ease, transform 0.3s ease;
  }

  /* Hover Effect */
  .login:hover {
    color: #2980b9; /* Darker Blue */
    transform: scale(1.1); /* Slight zoom effect */
  }

  /* Focus Effect */
  .login:focus {
    outline: none; /* Removes the default outline when clicked */
    text-decoration: underline; /* Underlines the link on focus */
  }

  /* Optional: Adding some padding and margin for spacing */
  .login {
    padding: 10px 20px;
    margin: 10px 0;
    display: inline-block;
  }
</style>


                 

                    <div class="hamburger">☰</div>
                </div>
            </div>
        </nav>

        <!-- Content Place Holder for Child Pages -->
        <div class="container">
            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
            </asp:ContentPlaceHolder>
        </div>
    </form>
    <style>* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background-color: #f5f5f5;
}

/* Navigation Bar Styles */
.navbar {
    background-color: #fff;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    padding: 10px 0;
    position: sticky;
    top: 0;
    z-index: 1000;
}

.navbar-container {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
}

.logo {
    display: flex;
    align-items: center;
    font-size: 1.5rem;
    font-weight: bold;
}

.heart {
    color: #ff4d4d;
    margin-right: 5px;
}

.logo-text {
    color: #333;
}

.nav-links {
    display: flex;
    list-style: none;
    align-items: center;
}

.nav-links li {
    margin: 0 15px;
    position: relative;
}

.nav-links a {
    text-decoration: none;
    color: #333;
    font-size: 1rem;
    font-weight: 500;
}

.nav-links a:hover {
    color: #ff4d4d;
}

/* Dropdown Styles */
.dropdown {
    position: relative;
}

.dropdown-toggle::after {
    content: "▼";
    font-size: 0.7rem;
    margin-left: 5px;
}

.dropdown-menu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    background-color: #fff;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    list-style: none;
    padding: 10px 0;
    min-width: 200px;
    z-index: 1000;
}

.dropdown-menu li {
    margin: 0;
}

.dropdown-menu a {
    display: block;
    padding: 10px 20px;
    color: #333;
    font-size: 0.9rem;
}

.dropdown-menu a:hover {
    background-color: #f5f5f5;
    color: #ff4d4d;
}

.dropdown:hover .dropdown-menu {
    display: block;
}

/* Right Side (Login/Signup) */
.nav-right {
    display: flex;
    align-items: center;
}

.nav-right a {
    margin-left: 15px;
    text-decoration: none;
    font-size: 1rem;
}

.desktop-icon {
    color: #333;
}

.login {
    color: #333;
}

.signup {
    background-color: #ff4d4d;
    color: #fff;
    padding: 8px 15px;
    border-radius: 5px;
}

.signup:hover {
    background-color: #e04343;
}

.hamburger {
    display: none;
    font-size: 1.5rem;
    cursor: pointer;
}

/* Main Content Styles */
.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 40px 20px;
}

/* Header Styles */
.header {
    text-align: center;
    margin-bottom: 40px;
}

.header h1 {
    font-size: 2.5rem;
    color: #333;
    margin-bottom: 10px;
}

.header p {
    font-size: 1.1rem;
    color: #666;
    line-height: 1.5;
}

/* Grid Styles */
.grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.card {
    background-color: #fff;
    border-radius: 8px;
    padding: 20px;
    box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    text-align: center;
    transition: transform 0.2s;
}

.card:hover {
    transform: translateY(-5px);
}

.card .icon {
    font-size: 2rem;
    margin-bottom: 10px;
}

.card h3 {
    font-size: 1.2rem;
    color: #333;
    margin-bottom: 10px;
}

.card p {
    font-size: 0.9rem;
    color: #666;
    line-height: 1.4;
}

.new {
    background-color: #ff4d4d;
    color: #fff;
    font-size: 0.7rem;
    padding: 2px 6px;
    border-radius: 10px;
    margin-left: 5px;
}

/* Responsive Design */
@media (max-width: 768px) {
    .header h1 {
        font-size: 1.8rem;
    }

    .header p {
        font-size: 1rem;
    }

    .grid {
        grid-template-columns: 1fr;
    }

    /* Mobile Navigation */
    .nav-links {
        display: none;
        flex-direction: column;
        position: absolute;
        top: 60px;
        left: 0;
        width: 100%;
        background-color: #fff;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    .nav-links.active {
        display: flex;
    }

    .nav-links li {
        margin: 10px 0;
        text-align: center;
    }

    .dropdown-menu {
        position: static;
        box-shadow: none;
        background-color: #f5f5f5;
    }

    .nav-right .desktop-icon,
    .nav-right .login,
    .nav-right .signup {
        display: none;
    }

    .hamburger {
        display: block;
    }

}</style>
               
</body>

</html>